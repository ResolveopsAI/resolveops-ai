APP_ENV=dev
LOG_LEVEL=info

AUTH_SERVICE_URL=http://auth-service:8000
GITHUB_INTELLIGENCE_SERVICE_URL=http://github-intelligence-service:8000
AZURE_INTELLIGENCE_SERVICE_URL=http://azure-intelligence-service:8000
AWS_INTELLIGENCE_SERVICE_URL=http://aws-intelligence-service:8000
AI_RCA_SERVICE_URL=http://ai-rca-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
API_GATEWAY_URL=http://api-gateway-service:8000

# Use Groq through an OpenAI-compatible API endpoint.
# The project only recognizes AI_PROVIDER=openai or AI_PROVIDER=bedrock.
AI_PROVIDER=openai
AWS_REGION=us-east-1

OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=your-groq-openai-api-key
OPENAI_BASE_URL=https://api.groq.cloud/v1
OPENAI_MODEL=groq-code-api
OPENAI_MODEL_NAME=groq-code-api

# Security & Secrets
# IMPORTANT: Do NOT commit real secrets to the repository. Copy these values into a local `.env` on the EC2 host.
JWT_SECRET=thisisaverylongjwtsecrestthesecretisverysecretsokeepitsecret
MCP_SERVICE_TOKEN=local-mcp-service-token-dev-only
INTERNAL_SERVICE_TOKEN=local-internal-service-token-dev-only
ADMIN_INVITE_CODE=resolveops-admin-2026

# Database credentials (DB_PASSWORD kept for compatibility with some services)
DB_PASSWORD=local-db-pass

# Database
POSTGRES_USER=resolveopsadmin
POSTGRES_PASSWORD=local-db-pass
POSTGRES_DB=resolveopsdb
DATABASE_URL=postgresql://resolveopsadmin:local-db-pass@postgres:5432/resolveopsdb

# Local storage (set to /app/data/artifacts inside containers)
STORAGE_ACCOUNT_NAME=local
BLOB_CONTAINER_NAME=local
LOCAL_STORAGE_DIR=/app/data/artifacts

# Notifications / Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sathviknbmath@gmail.com
SMTP_PASSWORD=tmkvinpcnxlveiik
SENDER_EMAIL=sathviknbmath@gmail.com

# Container Service Visibility Allow-List
ALLOWED_DOCKER_SERVICES=frontend,api-gateway-service,ai-rca-service,aws-intelligence-service,github-intelligence-service,mcp-server-service,notification-service,docker-evidence-adapter,auth-service,azure-intelligence-service,postgres

# Operational Restart Allow-Lists and Protected Policies
RESTARTABLE_DOCKER_SERVICES=github-intelligence-service,aws-intelligence-service,azure-intelligence-service,mcp-server-service,notification-service,ai-rca-service,frontend
PROTECTED_DOCKER_SERVICES=postgres,api-gateway-service,auth-service,docker-operations-service

# Log Limits & Streaming Bounds
DOCKER_LOG_DEFAULT_TAIL=200
DOCKER_LOG_MAX_TAIL=1000
DOCKER_LOG_MAX_MINUTES=60
DOCKER_LOG_MAX_CHARACTERS=50000
DOCKER_LOG_STREAM_MAX_SECONDS=300

# Container Action Governance & Approval
CONTAINER_ACTION_APPROVAL_REQUIRED=true
CONTAINER_ACTION_EXPIRY_MINUTES=15
CONTAINER_RESTART_TIMEOUT_SECONDS=120

# Multi-Channel Operational Alerting
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

ALERT_CPU_THRESHOLD_PERCENT=85
ALERT_MEMORY_THRESHOLD_PERCENT=85
ALERT_EVALUATION_MINUTES=5
ALERT_COOLDOWN_MINUTES=15
